@page "/"
@inject Cashy.Services.SessionService SessionService

<h1>Hello, world!</h1>

@if (!string.IsNullOrEmpty(username))
{
    <p>Welcome back, @username!</p>
}
else
{
    <p>Welcome to your new app. Please log in!</p>
}

@code {
    private string username;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Retrieve the username from the session storage
            username = await SessionService.GetSessionData("username");

            // Handle cases where session data is not available
            if (string.IsNullOrEmpty(username))
            {
                // Optionally, display a default message
                username = "Guest";
            }
        }
        catch (Exception ex)
        {
            // Handle error if session retrieval fails
            username = $"Error: {ex.Message}";
        }
    }
}

