@page "/"
@inject Cashy.Services.SessionService SessionService

<h1>Hello, world!</h1>

@if (!string.IsNullOrEmpty(username))
{
    <p>Welcome back, @username!</p>
}
else
{
    <p>Welcome to your new app. Please log in!</p>
}

@code {
    private string username;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            username = await SessionService.GetSessionData("username");
            if (string.IsNullOrEmpty(username))
            {
                username = "Guest";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in MainLayout: {ex.Message}");
            username = "Error loading username.";
        }
    }
}
